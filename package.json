{
  "name": "@happydesigns/brand",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Reusable Nuxt UI brand layer for happydesigns.",
  "exports": {
    ".": "./nuxt.config.ts"
  },
  "scripts": {
    "generate:brand-css": "node scripts/generate-brand-css.mjs",
    "prebuild": "node scripts/generate-brand-css.mjs",
    "build": "node --max-old-space-size=8192 ./node_modules/nuxt/bin/nuxt.mjs build",
    "predev": "node scripts/generate-brand-css.mjs",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "node scripts/generate-brand-css.mjs && nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "pretypecheck": "node scripts/generate-brand-css.mjs",
    "typecheck": "nuxt typecheck",
    "verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@happydesigns/id": "file:..\\id",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@nuxt/ui": "^4.9.0",
    "@takumi-rs/core": "1.8.7",
    "docus": "^5.12.3",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@nuxt/eslint": "^1.15.2",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@10.33.0"
}

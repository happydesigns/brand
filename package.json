{
  "name": "@happydesigns/brand",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Reusable Nuxt UI brand layer for happydesigns.",
  "exports": {
    ".": "./nuxt.config.ts"
  },
  "scripts": {
    "generate:brand-css": "node scripts/generate-brand-css.mjs",
    "generate:runtime-layer": "vitest run --config scripts/vitest.generate.config.ts",
    "prebuild": "node scripts/generate-brand-css.mjs",
    "build": "nuxt build",
    "predev": "node scripts/generate-brand-css.mjs",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "node scripts/generate-brand-css.mjs && nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "pretypecheck": "node scripts/generate-brand-css.mjs",
    "typecheck": "nuxt typecheck",
    "verify": "pnpm lint && pnpm test && pnpm typecheck"
  },
  "dependencies": {
    "@happydesigns/id": "file:..\\id",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.87",
    "@nuxt/ui": "^4.9.0",
    "docus": "^5.12.3",
    "nuxt": "^4.4.8",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "eslint": "^10.2.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@10.33.0"
}

{
  "name": "@happydesigns/brand",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Reusable Nuxt UI brand layer for happydesigns.",
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "public",
    "nuxt.config.ts",
    "README.md"
  ],
  "exports": {
    ".": "./nuxt.config.ts"
  },
  "scripts": {
    "generate:layer": "vitest run --config scripts/vitest.generate.config.ts",
    "prebuild": "pnpm generate:layer",
    "build": "nuxt build docs",
    "build:layer": "nuxt build",
    "predev": "pnpm generate:layer",
    "dev": "nuxt dev docs",
    "preview": "node .output/server/index.mjs",
    "prepare:docs": "nuxt prepare docs",
    "prelint": "pnpm prepare:docs",
    "lint": "eslint .",
    "pretest": "pnpm prepare:docs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "pretypecheck": "pnpm generate:layer",
    "typecheck": "nuxt typecheck docs",
    "verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm test:e2e && pnpm build"
  },
  "dependencies": {
    "@happydesigns/id": "file:..\\id",
    "@nuxt/ui": "^4.10.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@iconify-json/lucide": "^1.2.123",
    "@iconify-json/simple-icons": "^1.2.93",
    "@iconify-json/vscode-icons": "^1.2.61",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.62.1",
    "@tiptap/y-tiptap": "^3.0.8",
    "docus": "^5.12.3",
    "eslint": "^10.8.1",
    "nuxt": "^4.5.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.33.0"
}

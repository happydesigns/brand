    "roles": {
      "signature": "coral",
      "technical": "petrol",
      "positive": "seafoam",
      "informational": "plum",
      "caution": "butter",
      "destructive": "rose",
      "structure": "sand"
    },
    "typography": {
      "sans": "\"Bricolage Grotesque\", ui-sans-serif, system-ui, sans-serif",
      "mono": "\"Geist Mono\", \"SFMono-Regular\", ui-monospace, monospace"
    },
    "assets": {
      "logos": {
        "wordmark": {
          "name": "Wordmark",
          "src": "/logos/happydesigns-wordmark.svg",
          "role": "wordmark",
          "media": "light",
          "alt": "happydesigns wordmark"
        },
        "wordmarkInverse": {
          "name": "Wordmark inverse",
          "src": "/logos/happydesigns-wordmark-inverse.svg",
          "role": "wordmarkInverse",
          "media": "dark",
          "alt": "happydesigns wordmark"
        },
        "symbol": {
          "name": "Symbol",
          "src": "/logos/happydesigns-symbol.svg",
          "role": "symbol",
          "media": "any",
          "alt": "happydesigns symbol"
        },
        "symbolReduced": {
          "name": "Symbol reduced",
          "src": "/logos/happydesigns-symbol-reduced.svg",
